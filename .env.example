# Copy these into Vercel → Project → Settings → Environment Variables.
# (Do NOT commit real values. This file only documents the names.)

# A GitHub token that can read your repositories (public + private).
# Least privilege: a fine-grained token with "Metadata: Read-only" for all
# repositories is enough. A classic token with the "repo" scope also works.
GITHUB_TOKEN=

# The password that unlocks the /dashboard.html admin page.
ADMIN_SECRET=

# Added automatically when you attach Vercel KV (or Upstash Redis) to the
# project. You normally do NOT set these by hand.
KV_REST_API_URL=
KV_REST_API_TOKEN=
